NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase session pooler (5432) for both runtime and migrations.
# Use an absolute certificate path for your environment (/app/certs/... in Railway).
DATABASE_URL=postgresql://ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/ABSOLUTE/PATH/certs/supabase-ca.crt
DATABASE_URL_UNPOOLED=postgresql://ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/ABSOLUTE/PATH/certs/supabase-ca.crt

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=WPVoicePingBot
TELEGRAM_WEBHOOK_SECRET=

GHL_WEBHOOK_SECRET=
GHL_WALLPANELS_TOKEN=
GHL_VERONA_TOKEN=
WALLPANELS_LOCATION_ID=Iwpfx8zGzpsZszcnGovT
VERONA_LOCATION_ID=pSsHdL8pyBsLeIci1Py0

# Legacy optional contact-page templates. Call notifications use the verified
# conversationId route resolved through the HighLevel Conversations API.
WALLPANELS_CONTACT_URL_TEMPLATE=
VERONA_CONTACT_URL_TEMPLATE=

ADMIN_API_TOKEN=
LINK_CODE_PEPPER=
ADMIN_TELEGRAM_CHAT_IDS=

# Set after Railway provides the public HTTPS domain.
PUBLIC_BASE_URL=
